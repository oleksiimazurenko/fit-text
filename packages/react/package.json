{
  "name": "@oleksiimazurenko/react-fit-text",
  "version": "0.2.0",
  "description": "Fit text to its container with pure CSS — zero runtime JS. React component over the fit-text stylesheet core: container-query font sizing with language-aware hyphenation.",
  "keywords": [
    "react",
    "css",
    "container-queries",
    "cqi",
    "clamp",
    "typography",
    "fit-text",
    "responsive",
    "zero-js"
  ],
  "license": "MIT",
  "author": "Oleksii Mazurenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleksiimazurenko/fit-text.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/oleksiimazurenko/fit-text/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/oleksiimazurenko/fit-text/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oleksiimazurenko/fit-text": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
