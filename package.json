{
  "name": "fit-text-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Fit text to its container with pure CSS — zero runtime JS. Framework family (react, and later solid/svelte) over a shared CSS core.",
  "license": "MIT",
  "author": "Oleksii Mazurenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleksiimazurenko/fit-text.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.15.0"
}
